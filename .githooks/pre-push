#!/bin/sh
# localy-managed pre-push hook, written by `localy init`.
# Runs the chained hooks below first, then `localy run --profile fast`.
# A failing hook stops the push. Skip everything with LOCALY_SKIP=1 or
# `git push --no-verify`.

if [ "${LOCALY_SKIP:-}" = "1" ]; then
    echo "localy: LOCALY_SKIP=1, skipping pre-push checks" >&2
    exit 0
fi

root=$(git rev-parse --show-toplevel) || exit 1
git_common_dir=$(git rev-parse --path-format=absolute --git-common-dir) || exit 1

# git passes the refs being pushed on stdin; keep them for every hook.
input=$(mktemp "${TMPDIR:-/tmp}/localy-pre-push.XXXXXX") || exit 1
trap 'rm -f "$input"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
cat >"$input"

run_chained() {
    hook=$1
    shift
    [ -f "$hook" ] || return 0
    if [ ! -x "$hook" ]; then
        echo "localy: $hook is not executable, skipping it" >&2
        return 0
    fi
    "$hook" "$@" <"$input" || {
        status=$?
        echo "localy: $hook failed (exit $status), stopping the push" >&2
        exit "$status"
    }
}

# Chained hooks, kept by `localy init`:
# (none)

if ! command -v localy >/dev/null 2>&1; then
    echo "localy: not found on PATH, skipping pre-push checks" >&2
    exit 0
fi

# git sets GIT_DIR and friends for hooks (in a linked worktree at
# least). localy finds the repository itself, and a job's git commands
# must not be pointed at this one.
unset $(git rev-parse --local-env-vars)
localy run --profile fast --trigger hook -- "$@" <"$input"
